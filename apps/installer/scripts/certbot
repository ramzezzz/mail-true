#!/usr/bin/env bash
# ------------------------------------------------------------------
# Подставка вместо certbot внутри контейнера установщика.
#
# ------------------------------------------------------------------
# ЗАЧЕМ ОНА
# ------------------------------------------------------------------
# install/install.sh выпускает сертификат Let's Encrypt так же, как это
# делают на сервере руками: `certbot certonly --standalone`. Certbot при
# этом сам поднимает временный веб-сервер на 80-м порту — Let's Encrypt
# проверяет владение именем, постучавшись по нему снаружи.
#
# Изнутри контейнера 80-й порт ХОСТА недоступен: у контейнера своя сеть.
# Поставить сюда настоящий certbot значило бы получить сертификат «выдан»
# ровно никогда: проверка стучится на хост, а слушает контейнер.
#
# Поэтому certbot запускается отдельным контейнером, которому 80-й порт
# хоста отдан явно (-p 80:80). Сокет Docker у установщика уже есть — тот
# самый, ради которого он и существует. install/install.sh при этом ничего
# не знает про контейнеры: она вызывает `certbot`, находит его в PATH и
# работает как обычно. Двух путей выпуска сертификата не появляется.
#
# nginx на время проверки останавливает сама install.sh (и renew-certs.sh):
# 80-й порт в этот момент свободен. Почта не прерывается.
#
# ------------------------------------------------------------------
# ГДЕ ОСТАЮТСЯ ФАЙЛЫ
# ------------------------------------------------------------------
# В /etc/letsencrypt ХОСТА — том смонтирован и сюда, и в контейнер certbot.
# Иначе сертификат исчез бы вместе с установщиком, а продлевать на сервере
# было бы нечего: install/renew-certs.sh ищет его именно там.
#
# Образ certbot/certbot скачивается при первом обращении (около 150 МБ) —
# только если человек выбрал Let's Encrypt.
# ------------------------------------------------------------------
set -euo pipefail

exec docker run --rm \
    -p 80:80 \
    -v /etc/letsencrypt:/etc/letsencrypt \
    -v /var/lib/letsencrypt:/var/lib/letsencrypt \
    -v /var/log/letsencrypt:/var/log/letsencrypt \
    certbot/certbot:latest "$@"
