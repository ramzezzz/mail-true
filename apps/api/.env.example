# Конфигурация API Mail.True. Скопируйте в .env и поправьте под окружение.

NODE_ENV=development

# HTTP-сервер API
HOST=127.0.0.1
PORT=3001

# Проверка TLS-сертификатов IMAP/SMTP (false для самоподписанных в dev)
TLS_REJECT_UNAUTHORIZED=false

# Dovecot IMAP (проверка логина, чтение почты)
IMAP_HOST=127.0.0.1
IMAP_PORT=143
IMAP_SECURE=false

# Postfix submission (отправка почты; STARTTLS согласуется автоматически)
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false

# Redis для сессий. Внимание: в dev-стеке порт 6380 и пароль из infra/.env
REDIS_URL=redis://:mailtrue-redis-dev-2026@127.0.0.1:6380

# Postgres почтового стека (не обязателен для API)
#DATABASE_URL=postgres://mailserver:mailtrue-pg-dev-2026@127.0.0.1:5432/mailserver

# Сессии: redis (боевое) или memory (отладка без Redis)
SESSION_STORE=redis
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=mt_session
# Минимум 32 символа; в production обязательно поменять
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# true, когда API отдается по HTTPS
COOKIE_SECURE=false

# Временное хранилище загруженных вложений
UPLOAD_DIR=./data/uploads
# Заявленный предел загрузки. Действующий предел вложения вычисляется как
# min(UPLOAD_MAX_BYTES, MESSAGE_MAX_BYTES / 1.4) — в письме вложение едет
# в base64 и вырастает примерно в 1,37 раза. Если этого не учитывать, файл
# больше ~19 МБ не уйдет никогда, хотя загрузка примется.
UPLOAD_MAX_BYTES=26214400

# Предел письма на почтовом сервере. Должен совпадать с message_size_limit
# в infra/postfix/conf/main.cf.template
MESSAGE_MAX_BYTES=26214400

# Предел тела запроса на маршрутах написания письма (/api/messages/send,
# /api/drafts). Отдельно от общего: письмо со вставленными картинками
# законно бывает в разы больше обычного запроса
COMPOSE_BODY_MAX_BYTES=12582912

# Простой IMAP-соединения в пуле до закрытия, мс
IMAP_POOL_IDLE_MS=300000

# Ограничение частоты запросов (на IP)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Разрешенные Origin веб-интерфейса (через запятую)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=info

# ------------------------------------------------------------------
# Помощник на основе ИИ (apps/api/src/ai/). Подробности — docs/ai-spec.md
# ------------------------------------------------------------------
# Настройки сервиса ИИ (адрес, модель, ключ, предел расходов) задаются
# администратором домена в админке и лежат в базе (миграция 0004_ai.sql).
# Здесь только ключ шифрования ключей доступа: он не должен лежать рядом
# с данными. Минимум 32 символа, в production обязательно свой.
AI_ENCRYPTION_KEY=
# Общий выключатель на весь сервер
AI_ENABLED=true

# ------------------------------------------------------------------
# Настройки ящика и правила фильтрации (apps/api/src/settings/)
# ------------------------------------------------------------------
# База: если не задать, берётся ADMIN_DATABASE_URL, а затем DATABASE_URL
SETTINGS_DATABASE_URL=postgres://mailserver:CHANGE_ME@127.0.0.1:5432/mailserver
# Как API кладёт личный файл правил Sieve в почтовое хранилище:
#   local  — каталог /var/mail/vhosts виден процессу API (боевой Ubuntu)
#   docker — хранилище внутри контейнера Dovecot (dev-стек)
#   off    — не класть никуда (правила остаются только в базе)
SIEVE_TRANSPORT=docker
SIEVE_ROOT=/var/mail/vhosts
# Имя контейнера Dovecot для транспорта docker. Складывается из имени
# проекта compose: <COMPOSE_PROJECT_NAME>-dovecot-1 (по умолчанию проект
# называется mailtrue). Жёстких имён вида mail-dovecot больше нет — с ними
# два стенда на одной машине не поднимались. Посмотреть текущее:
#   docker compose -f infra/docker-compose.yml ps --format '{{.Name}}' dovecot
SIEVE_DOCKER_CONTAINER=mailtrue-dovecot-1
SIEVE_SCRIPT_NAME=mailtrue
SIEVE_OWNER=vmail:vmail
# Предел просмотра писем при «применить правило к уже полученным»
FILTER_APPLY_MAX_MESSAGES=5000

# ------------------------------------------------------------------
# Подключение своих и чужих ящиков (apps/api/src/accounts/)
# ------------------------------------------------------------------
ACCOUNTS_DATABASE_URL=postgres://mailserver:CHANGE_ME@127.0.0.1:5432/mailserver
# Ключ шифрования паролей чужих ящиков. Минимум 32 символа, в production — свой.
# Отдельно от SESSION_SECRET и AI_ENCRYPTION_KEY: см. apps/api/src/accounts/secret.ts
EXTERNAL_ACCOUNTS_KEY=CHANGE_ME_минимум_32_символа_0123456789
EXTERNAL_ACCOUNTS_ENABLED=true
# Планировщик сбора почты: как часто проверять, кому пора забирать
COLLECTOR_SCHEDULER=true
COLLECTOR_TICK_MS=60000
COLLECTOR_CONCURRENCY=2
COLLECTOR_BATCH_SIZE=50
# Предел на один сбор, мс. Чужой сервер может принять соединение и замолчать —
# без предела подключение вечно показывало бы «идёт синхронизация»
COLLECTOR_TIMEOUT_MS=600000
# Через сколько минут считать пометку «идёт сбор» брошенной. Нужно, если
# процесс убит на середине сбора: иначе ящик не собирался бы до перезапуска
COLLECTOR_STALE_MINUTES=30
# Автоопределение настроек чужого сервера: ходить ли в сеть (HTTP/DNS)
AUTODETECT_NETWORK=true
AUTODETECT_TIMEOUT_MS=4000
# Анонсируемые клиентам порты нашего сервера (для ящиков наших доменов)
IMAPS_PORT=993
PROVIDER_NAME=Mail.True
