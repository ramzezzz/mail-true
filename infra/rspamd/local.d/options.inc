# Общие параметры rspamd.
# Адрес своего резольвера подставляет entrypoint в override.d/options.inc
# (значение берётся из переменной RESOLVER_IP в infra/.env).

# Что считать «своим» адресом. По умолчанию rspamd относит к локальным все
# приватные сети (10/8, 172.16/12, 192.168/16), а наша docker-сеть лежит
# внутри 172.16/12 — тогда любое письмо из стека выглядело бы «локальным»
# и внешние списки для него не спрашивались бы. В проде почта приходит
# из интернета, поэтому оставляем локальным только сам хост.
local_addrs = ["127.0.0.0/8", "::1"];

# Общий предел времени на проверку письма. Если внешние источники не
# отвечают, rspamd не должен держать SMTP-сессию: лучше пропустить письмо
# без части проверок, чем остановить почту.
task_timeout = 8s;

# Встроенное распознавание GTUBE.
# По умолчанию rspamd на строку GTUBE сразу ставит действие reject, минуя
# подсчёт баллов, — письмо отбивается на SMTP и не попадает в ящик.
# Нам нужно, чтобы тестовый образец проходил весь конвейер и укладывался
# в папку Спам, поэтому встроенную обработку выключаем, а сам образец
# ловим правилом BLACKLIST_CONTENT (см. local.d/multimap.conf,
# maps.d/blacklist_content.map) с весом 10 — это выше порога «в Спам» (6),
# но ниже порога отказа (15).
gtube_patterns = "disabled";

# Как часто перечитывать карты из файлов (белые/чёрные списки в maps.d).
# 10 секунд: правка из админки вступает в силу почти сразу, а стоимость
# проверки — один stat() на файл.
map_watch_interval = 10s;

# Объекта dns здесь БОЛЬШЕ НЕТ, и это не упущение.
#
# Адрес резольвера подставляет entrypoint в override.d/options.inc, а
# override.d заменяет одноимённый объект ЦЕЛИКОМ. Пока таймаут и ретраи
# стояли здесь, их сносило этой заменой: `rspamadm configdump options`
# показывал в объекте dns один только nameserver, то есть проверки
# деградировали по умолчаниям rspamd (пять повторов), а не за секунду,
# как написано. Все параметры DNS задаются в одном месте — в
# infra/rspamd/entrypoint.sh, там же и разбор.
