# ==================================================================
# Камеры Mail.True: за что и на сколько банится адрес
# ==================================================================
#
# Файл собирается из jail.local.template подстановкой окружения
# (см. entrypoint.sh); значения приходят из infra/.env.
#
# ------------------------------------------------------------------
# ЗАЧЕМ ЭТО ВООБЩЕ НУЖНО
# ------------------------------------------------------------------
# В продукте уже есть три ограничителя, и ни один из них не останавливает
# подбор пароля по почтовым портам:
#
#   * веб-вход ограничен 10 попытками в минуту с адреса — но только веб;
#   * вход в панель запирает пару «учётка+адрес» — но только панель;
#   * Dovecot задерживает ответ на неверный пароль на 2 секунды — это
#     замедляет подбор, а не прекращает его: 2 секунды на попытку — это
#     43 тысячи паролей в сутки с ОДНОГО соединения, а соединений можно
#     открыть сколько угодно параллельно.
#
# Здесь появляется то, чего не было: адрес, с которого идёт подбор,
# перестаёт доходить до сервера вообще — на уровне пакетного фильтра.
#
# ------------------------------------------------------------------
# ПОЧЕМУ ВКЛЮЧЕНО ПО УМОЛЧАНИЮ
# ------------------------------------------------------------------
# Потому что почтовый сервер в интернете подбирают всегда. Не «если
# найдут», а с первых же часов после того, как порт 25 ответил: адреса
# перебираются веером по всей сети. Защита, которую надо включить руками,
# на таком сервере означает «выключена у всех, кто не читал документацию»,
# то есть у большинства.
#
# Цена ошибки при этом ограничена сознательно:
#   * пороги щадящие (см. каждую камеру ниже) — почтовая программа с
#     устаревшим паролем в них не попадает за несколько минут;
#   * приватные сети и подсеть стека не банятся никогда (ignoreip);
#   * первый бан короткий и снимается сам;
#   * FAIL2BAN_ENABLED=false в infra/.env выключает всё разом, служба
#     при этом остаётся живой и здоровой — не приходится выяснять,
#     «выключено» это или «сломалось».
# ==================================================================

[DEFAULT]

# Кого не банить никогда. Собирается в entrypoint.sh; там же объяснено,
# почему подсеть стека в этом списке обязательна (иначе первый же подбор
# пароля через веб-почту банит наш собственный контейнер api и веб-почта
# ложится у всех сразу).
ignoreip = ${F2B_IGNORE}

# Свои адреса — тоже мимо. Служба работает в сетевом пространстве хоста,
# поэтому «свои» здесь означает все адреса самого сервера.
ignoreself = true

# Имён в журналах нет — только адреса, и разрешать имена незачем.
# Обратный DNS на каждую строку журнала — это ещё и запрос наружу
# на каждую попытку подбора, то есть подарок тому, кто подбирает.
usedns = no

# Слежение за файлами по событиям (pyinotify), с откатом на опрос,
# если события недоступны.
backend = auto
logencoding = utf-8

# Сроки. По умолчанию: 15 промахов за 10 минут -> час бана.
bantime  = ${F2B_BANTIME}
findtime = ${F2B_FINDTIME}

# Нарастающий срок: второй бан того же адреса вдвое дольше, третий —
# вчетверо, и так до потолка. Смысл в том, что случайно попавший под
# бан человек теряет час один раз, а тот, кто вернулся подбирать пароль
# в пятый раз, уходит на неделю — и оба получают это без участия
# администратора.
bantime.increment = ${F2B_BANTIME_INCREMENT}
bantime.factor = 2
bantime.maxtime = ${F2B_BANTIME_MAX}

# Чем банить. Своё действие, а не штатное iptables-allports: штатное
# кладёт правило в цепочку INPUT, а трафик к опубликованным портам
# КОНТЕЙНЕРОВ через INPUT не проходит вовсе. Подробности — в самом
# файле action.d/mailtrue-iptables.conf.
banaction = mailtrue-iptables
banaction_allports = mailtrue-iptables
action = %(action_)s


# ==================================================================
# Dovecot: подбор пароля по IMAP и POP3
# ==================================================================
# Что ловит: строки dovecot.log про неудачную проверку пароля —
#   imap-login: Info: Disconnected: Aborted login (auth failed, 1 attempts
#     in 2 secs): user=<кто-то@домен>, method=PLAIN, rip=<адрес>, ...
# и такие же от pop3-login/managesieve-login, плюс подробные строки
# службы auth («unknown user», «Password mismatch»).
#
# Чего НЕ ловит намеренно: «no auth attempts» — это оборванное
# соединение и пробы состояния (в том числе наша собственная проба
# живости раз в полминуты), а не попытка входа. Ловить их значило бы
# банить сканеры портов вместе с собственным healthcheck.
#
# Порог 15 промахов за 10 минут выбран щадящим сознательно. Обычный
# источник ложных срабатываний — почтовая программа со СТАРЫМ паролем:
# смартфон, забытый в ящике стола, ходит за почтой по нескольку раз в
# минуту и за 10 минут набирает десяток промахов легко. Такой человек
# всё равно почту не получает, но час без доступа к серверу превращает
# «поменяй пароль в телефоне» в «сервер сломался». 15 попыток за 10
# минут — это заметно больше обычного поведения клиента и всё ещё
# ничтожно мало для подбора.
[mailtrue-dovecot]
enabled  = ${F2B_ENABLED}
filter   = mailtrue-dovecot
logpath  = ${MAILLOG_DIR}/dovecot.log
maxretry = ${F2B_DOVECOT_MAXRETRY}


# ==================================================================
# Postfix: подбор пароля при отправке (SASL на 587, 465, 25)
# ==================================================================
# Что ловит: строки postfix.log вида
#   postfix/submission/smtpd[42]: warning: unknown[<адрес>]:
#     SASL LOGIN authentication failed: ...
# и «too many errors after AUTH» — обрыв после серии неудачных команд
# аутентификации, почерк переборщика.
#
# Чего НЕ ловит: «SASL ... failed: Connection lost to authentication
# server». Это НАША неисправность (Dovecot, который проверяет пароли для
# Postfix, не отвечает), а не чужая попытка подбора. Отправитель здесь ни
# при чём, и банить его за то, что у нас упала служба аутентификации, —
# способ превратить одну аварию в две. Исключено в ignoreregex фильтра.
#
# Порог строже, чем у Dovecot (10 против 15), потому что источник ложных
# срабатываний здесь слабее: почтовая программа проверяет пароль на
# отправку только когда человек отправляет письмо, а не каждые пять минут
# в фоне. Десяток неудачных отправок за 10 минут — уже не опечатка.
[mailtrue-postfix-sasl]
enabled  = ${F2B_ENABLED}
filter   = mailtrue-postfix-sasl
logpath  = ${MAILLOG_DIR}/postfix.log
maxretry = ${F2B_POSTFIX_MAXRETRY}


# ==================================================================
# Наш сервер приложения: подбор пароля на веб-входе и во входе в панель
# ==================================================================
# Что ловит: строки api.log (формат pino, одна строка — один объект JSON)
# о неудачном входе, у которых есть адрес обратившегося.
#
# ------------------------------------------------------------------
# ЧТО ИМЕННО ЧИТАЕТ ЭТА КАМЕРА
# ------------------------------------------------------------------
# Сервер приложения пишет такие строки сам:
#
#   {"level":40,"time":1723200000000,"kind":"login.failed",
#    "ip":"203.0.113.7","msg":"Неудачная попытка входа"}
#
# — вход в почту (apps/api/src/routes/auth.ts) и "kind":"admin.login.failed"
# для панели (apps/api/src/admin/routes/auth.ts). Фильтр принимает поля
# kind, event и action, ключ адреса — ip, remoteAddress или clientIp, и
# любой порядок полей: чтобы новая строка подошла, не приходится угадывать
# её вид буква в букву.
#
# ВНИМАНИЕ на будущее: здесь долго стоял абзац «камере нечего читать, таких
# строк сервер не пишет». Он устарел и врал в обе стороны — администратор
# либо считал сетевой бан неработающим и городил вторую защиту, либо не
# понимал, откуда взялся бан. Правильное описание формата — рядом, в
# filter.d/mailtrue-api.conf; правя одно, сверяйтесь со вторым.
#
# Поверх сетевого бана продолжают работать прежние преграды: 10 попыток в
# минуту с адреса, а для панели — запирание пары «учётка+адрес».
#
# Порог 20 за 10 минут: сервер приложения и так не пропускает больше
# 10 попыток в минуту, поэтому 20 промахов за 10 минут — это не «человек
# забыл пароль», а осознанная работа по списку.
[mailtrue-api]
enabled  = ${F2B_ENABLED}
filter   = mailtrue-api
logpath  = ${MAILLOG_DIR}/api.log
maxretry = ${F2B_API_MAXRETRY}


# ==================================================================
# Повторные: кого банили уже несколько раз
# ==================================================================
# Читает журнал самого fail2ban и банит надолго тех, кто отбыл короткий
# бан и вернулся. Ложных срабатываний здесь почти не бывает по устройству:
# сюда попадают только адреса, которые УЖЕ прошли все проверки выше и
# были забанены не один раз.
#
# Три бана за сутки -> неделя. Это тот случай, когда длинный срок уместен:
# человек, который трижды за сутки исчерпал щадящий порог, паролем не
# ошибается — он его подбирает.
#
# Камера называется именно recidive, а фильтр указан явно — и то и другое
# нарочно. Штатный фильтр recidive исключает из подсчёта баны, выданные
# камерой с ЕГО ЖЕ именем: иначе она считала бы собственные баны и
# продлевала бы их сама себе по кругу. Исключение сверяется по имени
# камеры, поэтому переименовывать её нельзя.
[recidive]
enabled   = ${F2B_RECIDIVE_ENABLED}
filter    = recidive
logpath   = ${F2B_LOG}
banaction = mailtrue-iptables
bantime   = ${F2B_RECIDIVE_BANTIME}
findtime  = 1d
maxretry  = ${F2B_RECIDIVE_MAXRETRY}
# Нарастающий срок здесь не нужен: срок и так недельный, а перемножать
# недели значит однажды забанить чей-то офисный адрес до конца года.
bantime.increment = false
