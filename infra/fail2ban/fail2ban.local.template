# Настройки самой службы fail2ban (не камер — камеры в jail.local).
#
# Файл собирается из fail2ban.local.template подстановкой окружения
# (см. entrypoint.sh). Править надо шаблон в репозитории, а не то, что
# получилось внутри контейнера: контейнер пересоздаётся при каждом
# обновлении, и правка внутри него живёт до первого `up -d`.

[Definition]

loglevel = ${F2B_LOGLEVEL}

# Журнал — в файл, а не в stdout, и это не прихоть.
#
# Камера «повторные» (recidive в jail.local) ловит тех, кого уже банили,
# и единственный источник этих сведений — журнал самого fail2ban. Из
# stdout контейнера его не прочитать ничем, кроме сокета Docker, а сокет
# Docker в этом стеке означает права root на всей машине и даётся только
# посреднику перезапуска и установщику.
#
# В stdout журнал при этом всё равно попадает: entrypoint.sh переливает
# файл через `tail -F`, поэтому `docker compose logs fail2ban` работает
# как у любой другой службы стека.
logtarget = ${F2B_LOG}

# База банов на постоянном месте (bind-монт infra/data/fail2ban).
#
# Без неё перезапуск контейнера — а его делает любое обновление продукта —
# снимал бы все действующие баны разом. Подбиравший пароль продолжал бы
# с того же места, а нарастающий срок бана (bantime.increment) начинал
# бы счёт заново, то есть не работал бы вовсе.
dbfile = ${F2B_DB}

# Сколько помнить прошлые баны. Срок должен быть заметно больше самого
# длинного бана, иначе «нарастающий срок» упирается в забывчивость базы:
# запись о прошлом бане исчезает раньше, чем адрес приходит снова.
dbpurgeage = 30d

socket = /var/run/fail2ban/fail2ban.sock
pidfile = /var/run/fail2ban/fail2ban.pid
