# master.cf Postfix. Chroot отключён везде (контейнер и pgsql-карты).
# ==========================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ==========================================================================
smtp       inet  n       -       n       -       -       smtpd
submission inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  # Отправитель должен принадлежать вошедшему. Без этой строки любой
  # сотрудник отправлял письмо от имени директора, и наш же сервер
  # подписывал его нашим ключом DKIM — у получателя все проверки
  # подлинности проходили. Проверено на стенде: обычный ящик вошёл и
  # отправил письмо от чужого адреса, сервер принял без возражений.
  # Карта соответствия — pgsql/sender_login.cf: свой адрес плюс адреса
  # алиасов, которые ведут на этот ящик.
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
# Порт 465: TLS сразу, без STARTTLS. Нужен обязательно, потому что сервис
# автонастройки анонсирует его почтовым клиентам наравне с 587 — Outlook и
# почта Apple часто выбирают именно 465. Анонсировать порт и не слушать его
# означало бы, что клиент настроится и не сможет отправить письмо.
submissions inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submissions
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_helo_restrictions=
  # Отправитель должен принадлежать вошедшему. Без этой строки любой
  # сотрудник отправлял письмо от имени директора, и наш же сервер
  # подписывал его нашим ключом DKIM — у получателя все проверки
  # подлинности проходили. Проверено на стенде: обычный ящик вошёл и
  # отправил письмо от чужого адреса, сервер принял без возражений.
  # Карта соответствия — pgsql/sender_login.cf: свой адрес плюс адреса
  # алиасов, которые ведут на этот ящик.
  -o smtpd_sender_restrictions=reject_sender_login_mismatch
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o smtpd_recipient_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
pickup     unix  n       -       n       60      1       pickup
cleanup    unix  n       -       n       -       0       cleanup
qmgr       unix  n       -       n       300     1       qmgr
tlsmgr     unix  -       -       n       1000?   1       tlsmgr
rewrite    unix  -       -       n       -       -       trivial-rewrite
bounce     unix  -       -       n       -       0       bounce
defer      unix  -       -       n       -       0       bounce
trace      unix  -       -       n       -       0       bounce
verify     unix  -       -       n       -       1       verify
flush      unix  n       -       n       1000?   0       flush
proxymap   unix  -       -       n       -       -       proxymap
proxywrite unix  -       -       n       -       1       proxymap
smtp       unix  -       -       n       -       -       smtp
relay      unix  -       -       n       -       -       smtp
  -o syslog_name=postfix/$service_name
showq      unix  n       -       n       -       -       showq
error      unix  -       -       n       -       -       error
retry      unix  -       -       n       -       -       error
discard    unix  -       -       n       -       -       discard
local      unix  -       n       n       -       -       local
virtual    unix  -       n       n       -       -       virtual
lmtp       unix  -       -       n       -       -       lmtp
anvil      unix  -       -       n       -       1       anvil
scache     unix  -       -       n       -       1       scache
postlog    unix-dgram n  -       n       -       1       postlogd
