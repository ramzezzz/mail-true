# Кто имеет право отправлять от данного адреса (smtpd_sender_login_maps).
#
# Postfix спрашивает: «адрес в поле отправителя — чей?», и сравнивает ответ с
# логином, под которым человек вошёл. Не совпало — письмо отвергается
# (reject_sender_login_mismatch в master.cf, только для портов отправки).
#
# Без этой карты любой сотрудник мог отправить письмо от имени директора, и
# наш же сервер подписал бы его нашим ключом DKIM — у получателя проверки
# подлинности прошли бы полностью. Проверено на стенде: обычный ящик
# аутентифицировался и отправил письмо от чужого адреса, сервер принял.
#
# Возвращаются ДВА вида владельцев:
#   1. сам ящик — человек всегда вправе писать от своего адреса;
#   2. владелец алиаса — тот, кому алиас ведёт: у кого адрес
#      support@ пересылается на ivanov@, тот вправе писать и от support@.
#
# Объединение через UNION: Postfix принимает несколько строк ответа и считает
# допустимым любой из перечисленных логинов.
hosts = postgres
user = ${POSTGRES_USER}
password = ${POSTGRES_PASSWORD}
dbname = ${POSTGRES_DB}
query = SELECT email FROM virtual_users WHERE email = '%s' AND active UNION SELECT destination FROM virtual_aliases WHERE source = '%s' AND active
