# Посредник перезапуска служб.
#
# Единственная служба стека, кроме установщика, у которой есть сокет
# Docker. Что она умеет и почему это безопасно — подробно в agent.pl;
# коротко: два действия (перезапустить процесс, пересоздать контейнер)
# над закрытым списком служб, никаких произвольных команд.
#
# Базовый образ — официальный docker:cli. В нём уже есть клиент Docker и
# плагин compose; ставить их пакетами поверх node или python значило бы
# положить в контейнер с сокетом Docker ещё и целую среду выполнения с
# менеджером пакетов, то есть удобный способ запустить в нём что угодно.
#
# Perl добавляется одним пакетом ради самого посредника — тем же
# соображением, что и у посредника очереди Postfix
# (infra/postfix/queue-agent.pl): он маленький, ничего за собой не тянет
# и уже используется в продукте, так что второго языка в стеке не заводит.
FROM docker:27-cli

# git нужен странице «Обновления»: по нему видно, на каком коммите
# работает сервер и что уже скачано, но не применено. В docker:cli он
# есть и сейчас, но полагаться на содержимое чужого базового образа
# нельзя — оно меняется между версиями молча.
RUN apk add --no-cache perl git

COPY agent.pl /usr/local/bin/service-agent.pl
RUN chmod 755 /usr/local/bin/service-agent.pl

# Своей пробы у контейнера нет намеренно.
#
# Проба означала бы обращение к посреднику раз в несколько секунд, а
# каждое обращение к нему — это запрос к сокету Docker. Живость посредника
# и так проверяется тем единственным, кому она нужна: сервер приложения
# спрашивает /healthz, когда человек открывает раздел настроек, и честно
# показывает отказ, если ответа нет.

CMD ["perl", "/usr/local/bin/service-agent.pl"]
