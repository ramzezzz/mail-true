# Параметры почтового стека Mail.True.
# Скопируйте в infra/.env и поменяйте пароли. Реальный .env не коммитится.

# Основной почтовый домен и hostname сервера
MAIL_DOMAIN=mail.local
MAIL_HOSTNAME=mail.local

# Публичный адрес сервера (IPv4). По нему панель проверяет обратную запись
# PTR — ту, без которой крупные почтовые службы отбивают письма ещё на
# подключении. Установщик определяет адрес сам и вписывает сюда; заполнять
# руками нужно, только если сервер за NAT и внешняя служба ошиблась.
# Пусто — проверка PTR опирается на A-запись почтового хоста.
MAIL_PUBLIC_IPV4=

# На каком адресе публиковать почтовые порты на боевой машине
# (install/compose.prod.yml). 0.0.0.0 — на всех; конкретный адрес нужен,
# когда на сервере несколько адресов и почта должна жить только на одном.
BIND_ADDRESS=0.0.0.0

# PostgreSQL (домены/ящики/алиасы)
POSTGRES_DB=mailserver
POSTGRES_USER=mailserver
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis (сессии, кэш, очереди, статистика rspamd)
# ВНИМАНИЕ: порт публикации на хост. 6380 по умолчанию, потому что на dev-машине
# порт 6379 бывает занят другим Redis (WSL и т.п.). Внутри docker-сети — redis:6379.
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380

# Rspamd: пароль веб-интерфейса/API (http://localhost:11334)
RSPAMD_PASSWORD=change-me-rspamd
RSPAMD_WEB_PORT=11334

# DKIM-селектор (DNS-запись: <selector>._domainkey.<домен>)
DKIM_SELECTOR=mail

# ------------------------------------------------------------------
# Свой рекурсивный DNS-резольвер (unbound)
# ------------------------------------------------------------------
# Бесплатные списки Spamhaus/URIBL не отвечают на запросы, пришедшие через
# публичные резольверы (8.8.8.8 и т.п.) — возвращают 127.255.255.254
# «blocked, open resolver». Поэтому стек резолвит DNS сам.
# Подсеть стека и фиксированный адрес резольвера в ней (docker-опция dns:
# принимает только IP, отсюда фиксация адреса).
DOCKER_SUBNET=172.28.0.0/16
RESOLVER_IP=172.28.0.53
# Фиксированный адрес Dovecot в той же подсети. Он нужен Postfix: тот
# отдаёт почту по адресу, а не по имени (см. DOVECOT_IP в docker-compose.yml).
#
# ВАЖНО: эти три значения меняются ТОЛЬКО вместе. Подсеть меняют, когда
# 172.28.0.0/16 занята чем-то ещё на машине, — и раньше в примере было
# только два ключа из трёх. Человек менял подсеть, адрес Dovecot оставался
# от старой, и стек падал с docker-ошибкой
#   «no configured subnet contains IP address 172.28.0.54»,
# в которой ни слова о том, где эта настройка живёт. Установщик теперь
# сверяет все три и говорит по-русски.
DOVECOT_IP=172.28.0.54
# Логировать каждый DNS-запрос (диагностика: «уходит ли запрос к списку»).
# На боевом сервере держать no — иначе лог растёт очень быстро.
UNBOUND_LOG_QUERIES=no
# DNSSEC-валидация ответов
UNBOUND_DNSSEC=yes

# ------------------------------------------------------------------
# Антивирус ClamAV — ВЫКЛЮЧЕН ПО УМОЛЧАНИЮ
# ------------------------------------------------------------------
# clamd с полными базами занимает ~1.2 ГБ памяти и ~350 МБ на диске.
# На VPS с 2 ГБ это больше половины всей памяти (весь остальной продукт,
# вместе с веб-интерфейсом и админкой, — около 380 МБ).
# Включать осознанно, двумя действиями:
#   1) CLAMAV_ENABLED=true
#   2) docker compose -f infra/docker-compose.yml --profile clamav up -d
CLAMAV_ENABLED=false

# Публикуемые порты (localhost)
SMTP_PORT=25
SUBMISSION_PORT=587
# submissions — «TLS сразу», без STARTTLS. Postfix его слушает всегда, но
# наружу на боевом сервере не публикуется: список портов postfix там задан
# заново в install/compose.prod.yml. Здесь это порт публикации на localhost
# для разработки — раньше он не был описан вовсе, и два стека на одной
# машине сталкивались на нём с docker-ошибкой «port is already allocated».
SUBMISSIONS_PORT=465
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

# Автонастройка почтовых клиентов (autoconfig/autodiscover)
# Прямой порт сервиса (для отладки) и порты nginx
AUTOCONFIG_PORT=8025
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ------------------------------------------------------------------
# Веб-интерфейс: сервер приложения (api), почта (web), админка (admin)
# ------------------------------------------------------------------
# Прямой порт сервера приложения на localhost — только для отладки.
# Браузер ходит через nginx; на боевом сервере порт не публикуется.
API_PORT=3000
API_LOG_LEVEL=info

# Секреты приложения. Генерируются установщиком случайными; при ручной
# установке задайте свои — не короче 32 символов, буквы и цифры.
#   SESSION_SECRET        подпись cookie почты и шифрование пароля в сессии
#   ADMIN_SESSION_SECRET  то же для сессии админки
#   AI_ENCRYPTION_KEY     шифрование ключей доступа к сервисам ИИ
#   EXTERNAL_ACCOUNTS_KEY шифрование паролей чужих ящиков (сбор почты)
# Без SESSION_SECRET стек не поднимется — это намеренно.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
ADMIN_SESSION_SECRET=change-me-admin-session-secret-32-chars
AI_ENCRYPTION_KEY=change-me-ai-encryption-key-32-chars
EXTERNAL_ACCOUNTS_KEY=change-me-external-accounts-key-32-chars

# Отдавать ли cookie только по HTTPS. На боевом сервере — true
# (install/compose.prod.yml выставляет его сам), на dev-стенде false.
COOKIE_SECURE=false
# Проверять сертификаты Dovecot/Postfix изнутри docker-сети.
# false: сертификат выписан на внешнее имя, а не на имя контейнера.
TLS_REJECT_UNAUTHORIZED=false

# Служебный (master) пользователь Dovecot — вход администратора в чужой ящик
# из админки без знания пароля владельца. Логин: «ящик*<DOVECOT_MASTER_USER>».
# Пустое значение выключает возможность полностью.
# Принимать ли пароль без шифрования соединения.
# yes — правильное боевое значение: без TLS пароль не принимается.
# Опускать до no допустимо только на машине разработки.
DOVECOT_DISABLE_PLAINTEXT_AUTH=yes

DOVECOT_MASTER_USER=mtadmin
DOVECOT_MASTER_PASSWORD=смените-этот-пароль

# ------------------------------------------------------------------
# Очередь писем и журналы в админке
# ------------------------------------------------------------------
# Общий секрет между сервером приложения и посредником к очереди Postfix
# (infra/postfix/queue-agent.pl). Посредник живёт ВНУТРИ контейнера postfix:
# очередью управляют только программы Postfix, а сокет Docker серверу
# приложения не даётся — он означает права root на всей машине.
#
# Порт наружу не публикуется, посредник доступен только внутри сети стека.
# ПУСТОЕ значение выключает раздел «Очередь» целиком (посредник не
# запускается вовсе) — админка честно скажет об этом вместо пустой таблицы.
#
# Сгенерировать:  openssl rand -hex 32
QUEUE_AGENT_TOKEN=
QUEUE_AGENT_PORT=11345

# Сколько дней хранить разобранную историю доставки (mail_flow_events).
# Источник — журнал Postfix, другого источника нет: сам Postfix историю
# обработанных писем нигде не держит.
MAIL_FLOW_RETENTION_DAYS=14
# Верхний предел числа записей: защита от того, что ночная рассылка
# заполнит диск. Старые вытесняются, даже если срок ещё не вышел.
MAIL_FLOW_MAX_ROWS=500000
