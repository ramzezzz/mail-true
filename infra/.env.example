# Параметры почтового стека Mail.True.
# Скопируйте в infra/.env и поменяйте пароли. Реальный .env не коммитится.

# Основной почтовый домен и hostname сервера
MAIL_DOMAIN=mail.local
MAIL_HOSTNAME=mail.local

# Публичный адрес сервера (IPv4). По нему панель проверяет обратную запись
# PTR — ту, без которой крупные почтовые службы отбивают письма ещё на
# подключении. Установщик определяет адрес сам и вписывает сюда; заполнять
# руками нужно, только если сервер за NAT и внешняя служба ошиблась.
# Пусто — проверка PTR опирается на A-запись почтового хоста.
MAIL_PUBLIC_IPV4=

# На каком адресе публиковать почтовые порты на боевой машине
# (install/compose.prod.yml). 0.0.0.0 — на всех; конкретный адрес нужен,
# когда на сервере несколько адресов и почта должна жить только на одном.
BIND_ADDRESS=0.0.0.0

# PostgreSQL (домены/ящики/алиасы)
POSTGRES_DB=mailserver
POSTGRES_USER=mailserver
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis (сессии, кэш, очереди, статистика rspamd)
# ВНИМАНИЕ: порт публикации на хост. 6380 по умолчанию, потому что на dev-машине
# порт 6379 бывает занят другим Redis (WSL и т.п.). Внутри docker-сети — redis:6379.
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380

# Rspamd: пароль веб-интерфейса/API (http://localhost:11334)
RSPAMD_PASSWORD=change-me-rspamd
RSPAMD_WEB_PORT=11334

# DKIM-селектор (DNS-запись: <selector>._domainkey.<домен>)
DKIM_SELECTOR=mail

# ------------------------------------------------------------------
# Свой рекурсивный DNS-резольвер (unbound)
# ------------------------------------------------------------------
# Бесплатные списки Spamhaus/URIBL не отвечают на запросы, пришедшие через
# публичные резольверы (8.8.8.8 и т.п.) — возвращают 127.255.255.254
# «blocked, open resolver». Поэтому стек резолвит DNS сам.
# Подсеть стека и фиксированный адрес резольвера в ней (docker-опция dns:
# принимает только IP, отсюда фиксация адреса).
DOCKER_SUBNET=172.28.0.0/16
RESOLVER_IP=172.28.0.53
# Фиксированный адрес Dovecot в той же подсети. Он нужен Postfix: тот
# отдаёт почту по адресу, а не по имени (см. DOVECOT_IP в docker-compose.yml).
#
# ВАЖНО: эти три значения меняются ТОЛЬКО вместе. Подсеть меняют, когда
# 172.28.0.0/16 занята чем-то ещё на машине, — и раньше в примере было
# только два ключа из трёх. Человек менял подсеть, адрес Dovecot оставался
# от старой, и стек падал с docker-ошибкой
#   «no configured subnet contains IP address 172.28.0.54»,
# в которой ни слова о том, где эта настройка живёт. Установщик теперь
# сверяет все три и говорит по-русски.
DOVECOT_IP=172.28.0.54
# Логировать каждый DNS-запрос (диагностика: «уходит ли запрос к списку»).
# На боевом сервере держать no — иначе лог растёт очень быстро.
UNBOUND_LOG_QUERIES=no
# DNSSEC-валидация ответов
UNBOUND_DNSSEC=yes

# ------------------------------------------------------------------
# Антивирус ClamAV — ВЫКЛЮЧЕН ПО УМОЛЧАНИЮ
# ------------------------------------------------------------------
# clamd с полными базами занимает ~1.2 ГБ памяти и ~350 МБ на диске.
# На VPS с 2 ГБ это больше половины всей памяти (весь остальной продукт,
# вместе с веб-интерфейсом и админкой, — около 380 МБ).
# Включать осознанно, двумя действиями:
#   1) CLAMAV_ENABLED=true
#   2) docker compose -f infra/docker-compose.yml --profile clamav up -d
CLAMAV_ENABLED=false

# Публикуемые порты (localhost)
SMTP_PORT=25
SUBMISSION_PORT=587
# submissions — «TLS сразу», без STARTTLS. Postfix его слушает всегда.
# Здесь это порт публикации на localhost для разработки; на боевом сервере
# список портов postfix задан заново в install/compose.prod.yml, и там
# порт 465 публикуется стандартным (раньше его там не было вовсе, и
# клиенты, получившие от нашей же автонастройки порт 465, упирались
# в «соединение отклонено»).
SUBMISSIONS_PORT=465
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995

# ------------------------------------------------------------------
# Автонастройка почтовых клиентов (autoconfig/autodiscover)
# ------------------------------------------------------------------
# Прямой порт сервиса (для отладки) и порты nginx
AUTOCONFIG_PORT=8025

# Имя продукта в мастерах настройки Thunderbird, Outlook и Apple Mail.
# Меняется при поставке под своей маркой (OEM) — вместе с логотипом входа.
PROVIDER_NAME=Mail.True
PROVIDER_SHORT_NAME=Mail.True

# АНОНСИРУЕМЫЕ порты — то, что автонастройка называет почтовым программам.
#
# Это НЕ порты публикации выше (SMTP_PORT, IMAPS_PORT и прочие): те говорят,
# на каком порту ХОСТА сервис доступен на этой машине, и их меняют, чтобы
# развести два стенда. Анонсируемый порт при этом обязан остаться
# стандартным, иначе клиентам разошлют настройку с чужой машины.
# Менять эти значения нужно только если почта действительно вынесена
# на нестандартные порты (например, провайдер блокирует 25/587).
AUTOCONFIG_IMAPS_PORT=993
AUTOCONFIG_IMAP_STARTTLS_PORT=143
AUTOCONFIG_POP3S_PORT=995
AUTOCONFIG_POP3_STARTTLS_PORT=110
AUTOCONFIG_SUBMISSION_PORT=587
AUTOCONFIG_SUBMISSIONS_PORT=465
# Уровень журнала сервиса автонастройки: fatal|error|warn|info|debug|trace
AUTOCONFIG_LOG_LEVEL=info

# Адрес для отчётов DMARC в рекомендуемых DNS-записях (запись _dmarc, rua).
# По умолчанию — postmaster@<MAIL_DOMAIN>; раскомментируйте, чтобы задать свой.
# Ключ намеренно закомментирован: пустое значение здесь означало бы
# `rua=mailto:` без адреса, а не «взять умолчание».
#DMARC_RUA=
# TTL в рекомендуемых DNS-записях, секунды
DNS_TTL=3600
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ------------------------------------------------------------------
# Веб-интерфейс: сервер приложения (api), почта (web), админка (admin)
# ------------------------------------------------------------------
# Прямой порт сервера приложения на localhost — только для отладки.
# Браузер ходит через nginx; на боевом сервере порт не публикуется.
API_PORT=3000
API_LOG_LEVEL=info

# Секреты приложения. Генерируются установщиком случайными; при ручной
# установке задайте свои — не короче 32 символов, буквы и цифры.
#   SESSION_SECRET        подпись cookie почты и шифрование пароля в сессии
#   ADMIN_SESSION_SECRET  то же для сессии админки
#   AI_ENCRYPTION_KEY     шифрование ключей доступа к сервисам ИИ
#   EXTERNAL_ACCOUNTS_KEY шифрование паролей чужих ящиков (сбор почты)
# Без SESSION_SECRET стек не поднимется — это намеренно.
SESSION_SECRET=change-me-session-secret-at-least-32-chars
ADMIN_SESSION_SECRET=change-me-admin-session-secret-32-chars
AI_ENCRYPTION_KEY=change-me-ai-encryption-key-32-chars
EXTERNAL_ACCOUNTS_KEY=change-me-external-accounts-key-32-chars

# Отдавать ли cookie только по HTTPS. На боевом сервере — true
# (install/compose.prod.yml выставляет его сам), на dev-стенде false.
COOKIE_SECURE=false
# Проверять сертификаты Dovecot/Postfix изнутри docker-сети.
# false: сертификат выписан на внешнее имя, а не на имя контейнера.
TLS_REJECT_UNAUTHORIZED=false

# Служебный (master) пользователь Dovecot — вход администратора в чужой ящик
# из админки без знания пароля владельца. Логин: «ящик*<DOVECOT_MASTER_USER>».
# Пустое значение выключает возможность полностью.
# Принимать ли пароль без шифрования соединения.
# yes — правильное боевое значение: без TLS пароль не принимается.
# Опускать до no допустимо только на машине разработки.
DOVECOT_DISABLE_PLAINTEXT_AUTH=yes

DOVECOT_MASTER_USER=mtadmin
DOVECOT_MASTER_PASSWORD=смените-этот-пароль

# ------------------------------------------------------------------
# Очередь писем и журналы в админке
# ------------------------------------------------------------------
# Общий секрет между сервером приложения и посредником к очереди Postfix
# (infra/postfix/queue-agent.pl). Посредник живёт ВНУТРИ контейнера postfix:
# очередью управляют только программы Postfix, а сокет Docker серверу
# приложения не даётся — он означает права root на всей машине.
#
# Порт наружу не публикуется, посредник доступен только внутри сети стека.
# ПУСТОЕ значение выключает раздел «Очередь» целиком (посредник не
# запускается вовсе) — админка честно скажет об этом вместо пустой таблицы.
#
# Сгенерировать:  openssl rand -hex 32
QUEUE_AGENT_TOKEN=
QUEUE_AGENT_PORT=11345

# Сколько дней хранить разобранную историю доставки (mail_flow_events).
# Источник — журнал Postfix, другого источника нет: сам Postfix историю
# обработанных писем нигде не держит.
MAIL_FLOW_RETENTION_DAYS=14
# Верхний предел числа записей: защита от того, что ночная рассылка
# заполнит диск. Старые вытесняются, даже если срок ещё не вышел.
MAIL_FLOW_MAX_ROWS=500000
# Как часто сборщик заглядывает в журнал Postfix, секунды.
# 0 — не собирать вовсе (раздел «Почтовый поток» останется пустым).
MAIL_FLOW_INTERVAL_SECONDS=5

# Снимки показателей сервера для графиков дашборда (server_metric_samples).
# Внешнего сборщика в стеке нет: снимки складывает сам сервер приложения.
MAIL_METRICS_INTERVAL_SECONDS=60
MAIL_METRICS_RETENTION_DAYS=7
MAIL_METRICS_MAX_ROWS=50000

# ==================================================================
# ДАЛЬШЕ — ТО, ЧТО КОД ЧИТАЛ, А ОПИСАНО НИГДЕ НЕ БЫЛО
# ==================================================================
# Все ключи ниже разбирались схемами окружения (apps/api/src/**/config.ts),
# но не встречались ни в этом файле, ни в docker-compose.yml. То есть
# настройка существовала, работала — и добраться до неё можно было только
# пересборкой образа. Целые разделы продукта оказывались ненастраиваемыми
# на боевой установке: уведомления при закрытой вкладке и логотипы
# отправителей целиком, вместе с их выключателями.
#
# Значения ниже — те же умолчания, что зашиты в код. Файл можно оставить
# как есть: смысл списка в том, чтобы настройки было ГДЕ УВИДЕТЬ.
# Ключи, закомментированные решёткой, по умолчанию ПУСТЫ — пустое значение
# у них означало бы не «взять умолчание», а «задать пустоту».

# ------------------------------------------------------------------
# Имя проекта Docker Compose
# ------------------------------------------------------------------
# Задаёт имена контейнеров (<проект>-<сервис>-<номер>), томов и сети.
# Менять нужно, только если на машине поднимается ВТОРОЙ стенд: тогда
# вместе с ним обязаны отличаться DOCKER_SUBNET, RESOLVER_IP, DOVECOT_IP
# и все публикуемые порты выше.
COMPOSE_PROJECT_NAME=mailtrue

# ------------------------------------------------------------------
# Вход в админку, сессии и уборка ящиков
# ------------------------------------------------------------------
ADMIN_SESSION_COOKIE_NAME=mt_admin
# Срок жизни сессии админки, секунды (8 часов)
ADMIN_SESSION_TTL_SECONDS=28800
# Неудачных попыток входа подряд до блокировки и срок блокировки
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOCKOUT_MINUTES=15
# Срок сеанса входа администратора в чужой ящик, секунды
ADMIN_MAILBOX_TTL_SECONDS=3600
# Квота нового ящика по умолчанию, байт (1 ГиБ)
ADMIN_DEFAULT_QUOTA_BYTES=1073741824
# Карантин каталога удалённого ящика до физического удаления, минуты.
# 0 — удалять сразу. Ненулевое значение даёт время передумать: письма
# из Maildir не восстанавливаются ничем, кроме резервной копии.
ADMIN_MAILBOX_PURGE_DELAY_MINUTES=0
# Как часто просыпается уборщик, секунды (0 — не запускать)
ADMIN_JANITOR_INTERVAL_SECONDS=60

# ------------------------------------------------------------------
# Сессии почты, пределы размеров и частоты запросов
# ------------------------------------------------------------------
# Срок жизни сессии почты, секунды (7 суток)
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=mt_session
# Ограничение частоты запросов: сколько запросов с адреса за окно
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Предел размера загружаемого вложения, байт (25 МиБ)
UPLOAD_MAX_BYTES=26214400
# Предел размера письма, байт. ОБЯЗАН совпадать с message_size_limit
# в infra/postfix/conf/main.cf.template — иначе письмо, принятое
# веб-интерфейсом, отобьёт наш же Postfix, и человек увидит отбойник
# на письмо, которое интерфейс только что принял.
MESSAGE_MAX_BYTES=26214400
# Предел тела JSON при написании письма, байт (12 МиБ). Связан с потолком
# кучи Node (API_NODE_OPTIONS): разбор запроса держит в памяти несколько
# его копий сразу, поэтому запас берётся кратный, а не впритык.
COMPOSE_BODY_MAX_BYTES=12582912
# Сколько простаивает IMAP-соединение в пуле до закрытия, мс
IMAP_POOL_IDLE_MS=300000
# Проба состояния /healthz: срок годности готового ответа и предел
# ожидания ОДНОЙ проверки внутри неё, мс
HEALTH_CACHE_MS=2000
HEALTH_PROBE_TIMEOUT_MS=3000
# Потолок кучи V8 у сервера приложения. Цель — VPS на 2 ГБ, поэтому
# задан явно: иначе Node считает предел от объёма памяти машины.
API_NODE_OPTIONS=--max-old-space-size=512
# Файл журнала сервера приложения в общем томе (его читает раздел
# «Журналы» админки). В stdout журнал идёт по-прежнему.
API_LOG_FILE=/var/log/mail/api.log
# Кому верить в заголовке X-Forwarded-For. Заголовок подставляет сам
# клиент, поэтому доверие «всем» означало бы обход ограничения частоты
# сменой заголовка и любой выдуманный адрес в журнале аудита.
# По умолчанию — петля и подсеть стека, где стоит nginx.
#TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.0/16
# Разрешённые Origin для межсайтовых запросов. Нужны только режиму
# разработки (vite на 5173/5174): через nginx почта и API живут на одном
# имени хоста. На боевом сервере значение задаёт install/compose.prod.yml.
#CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# Правила фильтрации (Sieve)
# ------------------------------------------------------------------
# Как сервер приложения кладёт личный файл правил в почтовое хранилище:
#   local  — каталог хранилища примонтирован в контейнер (так в стеке)
#   docker — хранилище внутри контейнера Dovecot (запуск API вне контейнера)
#   off    — не класть никуда (правила останутся только в базе)
SIEVE_TRANSPORT=local
# Предел просмотра писем при «применить правило к уже полученным»
FILTER_APPLY_MAX_MESSAGES=5000

# ------------------------------------------------------------------
# Разделы владельца ящика
# ------------------------------------------------------------------
# «Вход и действия»: сколько дней хранить свои записи о входах через
# браузер. Входы по IMAP/POP3 и отправка читаются из журналов почтовых
# служб и живут ровно столько, сколько живут журналы.
MAILBOX_ACCESS_LOG_DAYS=90

# «Выгрузка ящика»: собрать всю почту в ZIP-архив (папки — каталогами,
# письма — файлами .eml). Выключатель для закрытого контура: готовый
# архив — это копия всей переписки в открытом виде на диске сервера.
MAILBOX_EXPORT_ENABLED=true
# Сколько часов живёт готовый файл, потом удаляется вместе с правом его
# скачать. Двое суток — «заказал вечером, скачал на следующий день».
MAILBOX_EXPORT_TTL_HOURS=48
# Сколько выгрузок идёт одновременно на весь сервер. Одна: выгрузка
# грузит и Dovecot, и диск, и процессор, а две рядом не ускоряют ни одну.
MAILBOX_EXPORT_CONCURRENCY=1
# Потолок размера архива в байтах (20 ГБ). Дойдя до него, задание
# останавливается с понятной причиной, а не заполняет диск.
MAILBOX_EXPORT_MAX_BYTES=21474836480

# «Восстановление писем»: потолок срока хранения очищенной корзины.
# Сам срок в этих пределах выбирает владелец ящика — это его место.
TRASH_RECOVERY_MAX_DAYS=30

# ------------------------------------------------------------------
# Уведомления при закрытой вкладке (Web Push)
# ------------------------------------------------------------------
# Выключатель на весь сервер: false — подписки не выдаются вовсе.
PUSH_ENABLED=true
# Контакт администратора для службы доставки уведомлений (RFC 8292):
# mailto: или https:. Пусто — postmaster@<MAIL_DOMAIN>.
#PUSH_CONTACT=
# Ключи VAPID сервер генерирует сам при первом запуске и хранит в базе.
# Задавать их здесь нужно ровно в одном случае — при ПЕРЕНОСЕ установки
# на другой сервер: смена ключей обесценивает все выданные браузерам
# подписки, и людям придётся разрешать уведомления заново.
#PUSH_VAPID_PUBLIC_KEY=
#PUSH_VAPID_PRIVATE_KEY=
# Предел ожидания ответа службы доставки, мс
PUSH_TIMEOUT_MS=10000
# Сколько служба доставки хранит недоставленное уведомление, секунды
PUSH_TTL_SECONDS=86400
# Сколько непоказанных уведомлений держать в очереди на ящик и как долго
PUSH_PENDING_MAX=50
PUSH_PENDING_TTL_MS=21600000

# ------------------------------------------------------------------
# Логотипы отправителей (BIMI и favicon)
# ------------------------------------------------------------------
# Единственная часть продукта, которая по своей работе ходит в интернет
# С СЕРВЕРА (браузер к чужим сайтам не обращается — иначе владелец сайта
# узнавал бы, что его письмо сейчас читают). На закрытом контуре эти
# запросы недопустимы, поэтому выключатель обязан быть доступен.
SENDER_LOGOS_ENABLED=true
# Пределы ожидания одного DNS-запроса (BIMI-запись) и одного обращения
# по HTTPS за картинкой, мс
SENDER_LOGO_DNS_TIMEOUT_MS=2500
SENDER_LOGO_HTTP_TIMEOUT_MS=4000
# Сколько запрос интерфейса ждёт ещё не найденные логотипы, прежде чем
# ответить «ещё ищем», мс. Открытие папки не должно ждать чужой сети.
SENDER_LOGO_WAIT_MS=3500
# Сколько поисков идёт наружу одновременно и сколько НОВЫХ доменов
# сервер соглашается искать за минуту (свой исходящий поток)
SENDER_LOGO_CONCURRENCY=4
SENDER_LOGO_LOOKUPS_PER_MINUTE=60
# Сроки годности кэша, часы: найденный логотип (30 суток), ответ
# «логотипа нет» (7 суток), пауза после ошибки связи.
# Срок для «нет» нужен отдельно: без него каждое открытие папки дёргало бы
# DNS по доменам, у которых логотипа нет и не будет.
SENDER_LOGO_TTL_HOURS=720
SENDER_LOGO_MISS_TTL_HOURS=168
SENDER_LOGO_ERROR_TTL_HOURS=6

# ------------------------------------------------------------------
# Помощник на основе ИИ
# ------------------------------------------------------------------
# Какой сервис и с каким ключом — настройка в админке, а не здесь.
# Тут только общий выключатель на весь сервер: погасить помощника,
# не заходя в панель.
AI_ENABLED=true
# Сколько держать настройки домена в памяти, не перечитывая базу, мс
AI_SETTINGS_CACHE_MS=15000
# Префикс ключей ИИ в Redis (кэш результатов и учёт расходов)
AI_REDIS_PREFIX=mt:ai:

# ------------------------------------------------------------------
# Чужие ящики и сбор почты с них
# ------------------------------------------------------------------
# Выключатель раздела «чужие ящики» на весь сервер
EXTERNAL_ACCOUNTS_ENABLED=true
# Планировщик сбора: false — не забирать почту по расписанию
COLLECTOR_SCHEDULER=true
# Как часто планировщик проверяет, кому пора забирать почту, мс
COLLECTOR_TICK_MS=60000
# Сколько сборов идёт одновременно и сколько писем максимум забирать
# за один запуск. Немного — с той стороны чужой сервер, обслуживающий
# живых людей.
COLLECTOR_CONCURRENCY=2
COLLECTOR_BATCH_SIZE=50
# Предел на один сбор, мс (10 минут), и срок, после которого пометка
# «идёт сбор» считается брошенной, минуты. Второе нужно из-за перезапуска:
# пометка о начале остаётся в базе, и без срока давности ящик залипал бы
# в состоянии «собирается» навсегда.
COLLECTOR_TIMEOUT_MS=600000
COLLECTOR_STALE_MINUTES=30
# Автоопределение настроек чужого сервера по адресу ящика: ходить ли
# при этом в сеть (HTTP/DNS). На закрытом контуре — false.
AUTODETECT_NETWORK=true
AUTODETECT_TIMEOUT_MS=4000
# Разделитель служебного пользователя в логине «ящик*мастер»
# (DOVECOT_MASTER_SEPARATOR) настройкой НЕ является, хотя код его читает.
# Он обязан совпадать с auth_master_user_separator в конфигурации Dovecot
# (infra/dovecot/conf/dovecot.conf.template), а там записана звёздочка
# без подстановки. Ключ здесь развёл бы две стороны одного логина: сервер
# приложения собирал бы «ящик#мастер», Dovecot ждал бы «ящик*мастер»,
# и вход администратора в чужой ящик молча перестал бы работать.
# Значение зашито в infra/docker-compose.yml.

# ------------------------------------------------------------------
# Перенос почты с чужого сервера (раздел «Перенос почты»)
# ------------------------------------------------------------------
# Сколько ящиков переносить одновременно
MIGRATION_CONCURRENCY=2
# Через сколько часов брошенное задание сдаётся. Срок про ПАРОЛИ: они
# лежат зашифрованными ровно пока идёт задание, и брошенное задание
# должно когда-то сдаться, а не хранить их бессрочно.
MIGRATION_MAX_HOURS=48

# ------------------------------------------------------------------
# Проверка DNS домена в админке
# ------------------------------------------------------------------
# У кого спрашивать DNS при проверке публикации записей, через запятую.
# НЕ у своего unbound: тот резольвер наш, и проверка показала бы то, что
# мы сами себе прописали, а вопрос стоит «видит ли наши записи остальной
# интернет». Пусто — публичные резольверы по умолчанию.
#DNS_CHECK_RESOLVERS=

# ------------------------------------------------------------------
# ЧТО КОД ЧИТАЕТ, НО ЗДЕСЬ НАСТРОЙКОЙ НЕ ЯВЛЯЕТСЯ
# ------------------------------------------------------------------
# Перечислено, чтобы поиск по имени приводил сюда, а не в пустоту.
#
# SETTINGS_DATABASE_URL, ADMIN_DATABASE_URL, ACCOUNTS_DATABASE_URL,
# AI_DATABASE_URL, PUSH_DATABASE_URL, CONTACTS_DATABASE_URL —
#   отдельные строки подключения для отдельных разделов. Нужны только
#   если разделы разнесены по РАЗНЫМ базам; в обычной установке все они
#   берут DATABASE_URL, который собирает docker-compose.yml из
#   POSTGRES_* выше. Через этот файл они намеренно не задаются: пустая
#   строка для них означала бы не «взять умолчание», а «подключаться
#   по пустому адресу», и раздел молча ушёл бы в отказ.
#
# SIEVE_ROOT, SIEVE_OWNER, SIEVE_SCRIPT_NAME, SIEVE_DOCKER_CONTAINER,
# UPLOAD_DIR, BRANDING_DIR, MAIL_LOG_DIR, ADMIN_MAIL_ROOT,
# ADMIN_MAIL_INDEX_ROOT, IMAP_HOST/PORT, SMTP_HOST/PORT, RSPAMD_HOST,
# MAIL_QUEUE_AGENT_URL, REDIS_URL, DATABASE_URL, SESSION_STORE —
#   устройство стека, а не настройка: это точки монтирования томов,
#   имена сервисов внутри сети docker и владелец файлов почтового
#   хранилища (uid 5000, vmail). Заданы в infra/docker-compose.yml;
#   правка здесь ничего бы не изменила, а совпадать они обязаны
#   с конфигурацией соответствующих контейнеров.
#
# ATTACHMENT_MAX_BYTES —
#   не переменная окружения вовсе, а ВЫЧИСЛЯЕМОЕ значение: предел одного
#   вложения выводится из MESSAGE_MAX_BYTES с поправкой на рост при
#   кодировании (base64 добавляет около трети). Задавать его отдельно
#   значило бы разрешить настройку, при которой принятое вложение не
#   помещается в письмо.
