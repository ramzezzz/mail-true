#!/bin/sh
# Предел размера тела запроса — из настроек сервера, а не из числа в шаблоне.
#
# ------------------------------------------------------------------
# ЗАЧЕМ
# ------------------------------------------------------------------
# UPLOAD_MAX_BYTES (размер вложения) и MESSAGE_MAX_BYTES (размер письма)
# правятся в панели, в разделе «Настройки сервера». В шаблоне же стояло
# `client_max_body_size 30m` числом. Подняв предел в панели, человек
# упирался в nginx: тот отвечал 413 и СВОЕЙ страницей на HTML, а браузер
# ждёт от нас {error, message} — то есть вместо понятного «файл слишком
# большой» получалось невнятное «не удалось разобрать ответ сервера».
#
# ------------------------------------------------------------------
# ПОЧЕМУ .envsh И ПОЧЕМУ ЗДЕСЬ
# ------------------------------------------------------------------
# Файлы с расширением .envsh штатный образ nginx выполняет В ТЕКУЩЕЙ
# оболочке (см. соседний admin-allow.envsh), поэтому вычисленная здесь
# переменная доживает до подстановки шаблонов. Номер 16 — раньше
# 20-envsubst-on-templates.sh, который её и подставит.
#
# Запас поверх предела нужен всегда: письмо уходит с вложениями в base64
# (плюс треть) и с обвязкой multipart, а заголовки и границы добавляют
# ещё несколько килобайт. Полтора раза плюс мегабайт — с избытком, и это
# по-прежнему предел, а не его отсутствие.

: "${UPLOAD_MAX_BYTES:=26214400}"
: "${MESSAGE_MAX_BYTES:=26214400}"

_mt_limit_base="$UPLOAD_MAX_BYTES"
if [ "$MESSAGE_MAX_BYTES" -gt "$_mt_limit_base" ] 2>/dev/null; then
    _mt_limit_base="$MESSAGE_MAX_BYTES"
fi

# Если значение пришло нечисловым (опечатка в .env), не роняем nginx
# и не открываем предел настежь — возвращаемся к прежнему числу.
if ! [ "$_mt_limit_base" -ge 1 ] 2>/dev/null; then
    _mt_limit_base=26214400
fi

CLIENT_MAX_BODY_SIZE=$((_mt_limit_base * 3 / 2 + 1048576))
export CLIENT_MAX_BODY_SIZE
unset _mt_limit_base
