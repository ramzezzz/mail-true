#!/bin/sh
# ------------------------------------------------------------------
# Кому отвечает панель управления.
#
# По умолчанию — всем, и это осознанно: продукт ставят на VPS и ходят в
# панель из интернета. Но открытая всему миру форма входа в управление
# почтовым сервером — плохая мысль там, где её можно закрыть, а закрыть
# её было нечем: nginx выбирает сайт по заголовку Host, и любой, кто
# дотянулся до 443-го порта, подставляет «Host: admin.<домен>» и получает
# страницу входа. Пароль остаётся единственной преградой.
#
# Теперь есть ADMIN_ALLOW_NETWORKS в infra/.env: список сетей через
# запятую или пробел. Пусто — как раньше, отвечаем всем.
#
#   ADMIN_ALLOW_NETWORKS=192.168.0.0/16, 10.0.0.0/8
#   ADMIN_ALLOW_NETWORKS=203.0.113.7            # один адрес офиса
#
# ------------------------------------------------------------------
# ПОЧЕМУ ЭТО ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ СТРОКА В ШАБЛОНЕ
# ------------------------------------------------------------------
# Человеку удобно писать список сетей, а nginx нужны директивы:
#   allow 192.168.0.0/16; allow 10.0.0.0/8; deny all;
# Превращать одно в другое должен кто-то до запуска nginx. Официальный
# образ выполняет /docker-entrypoint.d/*.envsh В ТЕКУЩЕЙ оболочке (через
# точку), поэтому переменная, объявленная здесь, доживает до соседнего
# 20-envsubst-on-templates.sh и попадает в конфигурацию. Обычный .sh
# запускается в отдельной оболочке — и переменная умерла бы вместе с ней.
#
# Имя начинается на 15, чтобы файл выполнился ДО подстановки шаблонов (20).
# ------------------------------------------------------------------

ADMIN_ACCESS_RULES=''

if [ -n "${ADMIN_ALLOW_NETWORKS:-}" ]; then
    # Запятые и точки с запятой считаем разделителями наравне с пробелом:
    # человек напишет как привык, а не как удобно разбирать.
    _list=$(printf '%s' "$ADMIN_ALLOW_NETWORKS" | tr ',;' '  ')
    _rules=''
    _bad=''

    for _net in $_list; do
        [ -n "$_net" ] || continue
        # Пропускаем только то, что похоже на адрес или сеть: строка отсюда
        # уходит прямо в конфигурацию nginx, и «случайная» точка с запятой
        # в ней означала бы чужую директиву внутри нашего server-блока.
        case "$_net" in
            *[!0-9.:/abcdefABCDEF]*)
                _bad="$_bad $_net"
                continue
                ;;
        esac
        _rules="$_rules allow $_net;"
    done

    if [ -n "$_bad" ]; then
        # Отказ громкий и в журнал: тихо выбросить сеть из списка значит
        # оставить человека уверенным, что доступ ограничен, когда он нет.
        echo "mailtrue: в ADMIN_ALLOW_NETWORKS пропущены неразборчивые значения:$_bad" >&2
    fi

    if [ -n "$_rules" ]; then
        # Петля разрешена всегда: иначе проверка живости самого nginx
        # упиралась бы в собственный запрет.
        #
        # И сеть контейнеров — тоже. Это не послабление «ради удобства», а
        # необходимость: запрос с САМОЙ машины (curl с сервера, туннель
        # SSH, обращение по собственному внешнему адресу) приходит через
        # docker-proxy и выглядит как запрос от шлюза сети контейнеров —
        # 172.28.0.1, а не 127.0.0.1. Проверено живьём: без этого правила
        # панель отвечала 403 на запрос с собственного сервера, то есть
        # ровно там, где администратор чинит остальное.
        #
        # Что это открывает: доступ к панели для того, кто уже вошёл на
        # сервер или в один из его контейнеров. У такого человека и так
        # есть всё, включая базу и ключи, — запрет здесь ничего бы не
        # добавил. Запросы ИЗ ИНТЕРНЕТА сохраняют свой настоящий адрес и
        # под это правило не попадают (тоже проверено: с чужой машины
        # приезжает её адрес, а не шлюз).
        _local="allow 127.0.0.0/8; allow ::1/128;"
        if [ -n "${DOCKER_SUBNET:-}" ]; then
            _local="$_local allow ${DOCKER_SUBNET};"
        fi
        ADMIN_ACCESS_RULES="$_local$_rules deny all;"
        echo "mailtrue: панель отвечает только сетям:$_rules"
    fi
fi

export ADMIN_ACCESS_RULES
