# Автоопределение настроек почтовых клиентов (Mail.True).
# Шаблон обрабатывается entrypoint-ом образа nginx (envsubst): ${MAIL_DOMAIN}
# подставляется из окружения; переменные nginx ($host и т.п.) не трогаются.
#
# Имена хостов:
#   autoconfig.<домен>   — Mozilla Autoconfig (Thunderbird)
#   autodiscover.<домен> — Microsoft Autodiscover (Outlook)
#
# Служебные пути автонастройки на корневом домене (/.well-known/ и
# /autodiscover/autodiscover.xml) переехали в app.conf.template — туда,
# где живёт веб-интерфейс почты: на одном имени хоста может быть только
# один server-блок. Сами проверки автонастройки от этого не изменились.
#
# В dev сертификат самоподписанный (CN=mail.local) — клиентам/curl нужен -k.

# Адрес сервиса разрешается встроенным DNS Docker на каждом запросе
# (директива resolver объявлена в app.conf.template — в http-контексте она
# одна на весь nginx). Статический блок upstream здесь стоял раньше и был
# настоящей поломкой: nginx запоминал адрес контейнера навсегда, и после
# пересоздания autoconfig запросы уходили в чужой контейнер, занявший
# освободившийся адрес. Проверка здоровья при этом оставалась зелёной —
# отвечал-то кто-то, — а Thunderbird и Outlook получали не тот ответ.

# ------------------------------------------------------------------
# autoconfig.<домен> — Thunderbird: GET /mail/config-v1.1.xml
# ------------------------------------------------------------------
server {
    listen 80;
    listen 443 ssl;
    #
    # ЛЮБОЙ ДОМЕН, А НЕ ТОЛЬКО ОСНОВНОЙ.
    #
    # Панель требует и подтверждает запись `autoconfig.<домен>` для
    # КАЖДОГО почтового домена (см. admin/dns.ts), а обслуживалось только
    # имя основного: запросы остальных падали в default_server, где
    # `/mail/config-v1.1.xml` уходит в веб-интерфейс почты — Thunderbird
    # получал HTML вместо XML. Администратор при этом видел в проверке DNS
    # зелёную отметку.
    #
    # Маска безопасна: служба автонастройки выбирает домен по адресу из
    # запроса (`?emailaddress=…`), а не по имени узла, и для чужого домена
    # просто отдаст настройки этого сервера. Точное имя у nginx сильнее
    # маски, поэтому основной домен по-прежнему обслуживается этим же
    # блоком без изменений.
    server_name autoconfig.${MAIL_DOMAIN} autoconfig.*;

    http2 on;

    ssl_certificate     /certs/mail.crt;
    ssl_certificate_key /certs/mail.key;

    # Хост автонастройки смотрит в интернет наравне с почтовым, поэтому и
    # обходится с ним одинаково. Раньше здесь не было ни одного из этих
    # правил: nginx представлялся полной версией всем подряд (`server_name`
    # с маской ловит запрос к любому домену на сервере), а Autodiscover
    # принимал тело запроса размером по умолчанию.
    server_tokens off;
    client_max_body_size 256k;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options        "DENY" always;
    add_header Referrer-Policy        "same-origin" always;
    add_header X-Robots-Tag           "noindex, nofollow" always;

    # --- Подтверждение владения доменом для Let's Encrypt -----------
    #
    # БЕЗ ЭТОГО БЛОКА ВЫПУСК СЕРТИФИКАТА НЕ ПРОХОДИТ ВООБЩЕ.
    #
    # В обязательные имена сертификата входит `autoconfig.<домен>` (см.
    # expectedCertificateNames в packages/shared/src/tls-certificate.ts), а
    # Let's Encrypt проверяет КАЖДОЕ имя отдельно: стучится по HTTP на
    # `http://autoconfig.<домен>/.well-known/acme-challenge/<токен>`. Имя
    # точно совпадает с `server_name` этого блока, поэтому запрос попадал
    # сюда — и уходил в `location /`, то есть в службу автонастройки. У неё
    # такого маршрута нет: 404, провал одного имени рушит запрос целиком, и
    # сертификат не выпускался НИ ДЛЯ ОДНОГО имени.
    #
    # Из панели это выглядело так: и пробный выпуск, и настоящий отказывают
    # всегда, сервер остаётся на самоподписанном сертификате, почтовые
    # программы ругаются на недоверенный узел. Консольный путь при этом
    # работал — install.sh выпускает через `--standalone` с остановкой
    # nginx, — и расхождение проявлялось только в панели.
    #
    # Тот же блок с тем же обоснованием уже стоит в app.conf.template; сюда
    # его забыли перенести.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type "text/plain";
        # Файлы кладёт certbot и сразу убирает; кэшировать нечего.
        add_header Cache-Control "no-store" always;
        # Свой add_header в location отменяет наследование ВСЕХ серверных
        # add_header, поэтому заголовки безопасности приходится повторять
        # здесь целиком — иначе на этом пути они просто не отдаются.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options        "DENY" always;
        add_header Referrer-Policy        "same-origin" always;
        add_header X-Robots-Tag           "noindex, nofollow" always;
    }

    location / {
        set $autoconfig_upstream http://autoconfig:8080;
        proxy_pass $autoconfig_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ------------------------------------------------------------------
# autodiscover.<домен> — Outlook: POST/GET /autodiscover/autodiscover.xml
# (регистр пути бывает разным — сервис обрабатывает без учёта регистра)
# ------------------------------------------------------------------
server {
    listen 80;
    listen 443 ssl;
    # Та же причина, что и у autoconfig выше: Outlook ходит на
    # `autodiscover.<свой домен>`, и таких доменов на сервере может быть
    # много. Запасной путь через default_server остаётся на месте.
    server_name autodiscover.${MAIL_DOMAIN} autodiscover.*;

    http2 on;

    ssl_certificate     /certs/mail.crt;
    ssl_certificate_key /certs/mail.key;

    # Хост автонастройки смотрит в интернет наравне с почтовым, поэтому и
