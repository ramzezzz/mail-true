# dovecot.conf (шаблон; ${MAIL_DOMAIN} подставляется из .env при старте)
# Самодостаточный конфиг — файлы conf.d дистрибутива не подключаются.

protocols = imap pop3 lmtp
listen = *

log_path = /dev/stdout
auth_verbose = yes
mail_debug = no

# Dovecot очищает окружение служебных процессов; MAIL_DOMAIN нужен скрипту
# quota-warning.sh, чтобы подставить адрес отправителя предупреждения.
import_environment = $import_environment MAIL_DOMAIN

# ------------------------------------------------------------------
# Хранилище: Maildir /var/mail/vhosts/<домен>/<логин>
# Индексы (в т.ч. полнотекстовый Xapian) вынесены в отдельный том
# /var/mail/index, чтобы не смешивать их с письмами и не считать в квоту.
# ------------------------------------------------------------------
mail_location = maildir:/var/mail/vhosts/%d/%n:INDEX=/var/mail/index/%d/%n
mail_uid = vmail
mail_gid = vmail
first_valid_uid = 5000
last_valid_uid = 5000

# Как часто сервер смотрит, не появилось ли новых писем в открытой папке.
#
# По умолчанию 30 секунд — и ровно столько человек ждал, прежде чем узнать о
# новом письме: подписка веб-интерфейса живёт на IMAP IDLE, а IDLE у Maildir
# просыпается по этому же расписанию. Замерено на стенде: событие о письме
# приходило через 15 секунд после доставки (половина цикла в среднем).
#
# Две секунды — это проверка каталога раз в две секунды на каждую открытую
# папку. Для почтового сервера на несколько сотен ящиков это ничто, а разница
# для человека — между «письмо появилось сразу» и «через полминуты».
mailbox_idle_check_interval = 2 secs

# Плагины подключаются всем протоколам: fts+fts_xapian — полнотекстовый поиск,
# quota — учёт занятого места.
mail_plugins = fts fts_xapian quota

namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Spam {
    auto = subscribe
    special_use = \Junk
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
}

# ------------------------------------------------------------------
# Аутентификация: логин = полный e-mail, пароли в PostgreSQL
# (SHA512-CRYPT или ARGON2ID — схема хранится в самом хэше)
# ------------------------------------------------------------------
# Пароль открытым текстом без шифрования — только для разработки.
# На боевом сервере значение обязано быть yes, иначе пароль пользователя
# уходит по сети в открытом виде. Поэтому это параметр, а не константа:
# в infra/.env.example стоит yes, и установщик ставит боевое значение,
# а разработческий infra/.env явно понижает его до no ради тестов,
# которые ходят на 143 без TLS.
disable_plaintext_auth = ${DOVECOT_DISABLE_PLAINTEXT_AUTH}
auth_mechanisms = plain login
auth_username_format = %Lu

# Про задержку после неудачных попыток входа — важно знать при обслуживании.
#
# auth_failure_delay (по умолчанию 2 с) задерживает ответ на неверный пароль,
# и пока эти ответы удерживаются, следующие проверки встают в очередь.
# Измерено на живом стеке: после десяти подряд неверных паролей первая ВЕРНАЯ
# проверка отработала 4536 мс вместо обычных 400, вторая — снова 393 мс.
# При большем всплеске задержка способна перерасти таймаут Postfix, и тогда
# отправка падает с «Connection lost to authentication server».
#
# Это защита от подбора пароля, и работает она как задумано — трогать её
# не нужно. Но знать стоит: всплеск неудачных входов ненадолго замедляет
# отправку и остальным. Пробовали снять общий штраф через
# login_trusted_networks для внутренней сети — измерение показало, что
# на эту задержку оно не влияет, поэтому послабление убрано: ослаблять
# защиту без доказанной пользы незачем.

# ------------------------------------------------------------------
# Служебный (master) пользователь — вход администратора в чужой ящик
# без знания пароля владельца и без подмены этого пароля.
#
# Логин выглядит как «ящик*служебный_пользователь», пароль — служебного
# пользователя (auth_master_user_separator ниже). Файл с учётной записью
# создаёт entrypoint.sh из DOVECOT_MASTER_USER/DOVECOT_MASTER_PASSWORD;
# если переменные не заданы, файл пустой и войти так нельзя.
#
# Блок стоит ПЕРВЫМ: обычная проверка пароля владельца при этом
# не выполняется (result_success = return-ok по умолчанию для master).
# ------------------------------------------------------------------
auth_master_user_separator = *

passdb {
  driver = passwd-file
  args = /etc/dovecot/master-users
  master = yes
}

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}
# userdb тоже из SQL: оттуда приходит quota_rule по столбцу virtual_users.quota_bytes
userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

# ------------------------------------------------------------------
# TLS (самоподписанные сертификаты для разработки)
# ------------------------------------------------------------------
ssl = yes
ssl_cert = </certs/mail.crt
ssl_key = </certs/mail.key
ssl_min_protocol = TLSv1.2

# ------------------------------------------------------------------
# Сервисы: LMTP для Postfix (24), SASL-auth для Postfix (12345)
# ------------------------------------------------------------------
service lmtp {
  inet_listener lmtp {
    port = 24
  }
}

service auth {
  inet_listener {
    port = 12345
  }
}

service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service pop3-login {
  inet_listener pop3 {
    port = 110
  }
  inet_listener pop3s {
    port = 995
    ssl = yes
  }
}

# ------------------------------------------------------------------
# Полнотекстовый поиск: индексация в фоне + разбор вложений
# ------------------------------------------------------------------
# indexer принимает заявки от LMTP/IMAP, indexer-worker строит индекс — то есть
# индекс появляется сразу при доставке письма, а не при первом поиске.
service indexer-worker {
  # Xapian держит индекс в памяти небольшими порциями; лимита по умолчанию мало
  vsz_limit = 2G
  process_limit = 2
}

# Служба извлечения текста из вложений (PDF, документы, таблицы).
# Скрипт лежит в образе, разборщики поставлены туда же (см. Dockerfile).
service decode2text {
  executable = script /usr/lib/dovecot/decode2text.sh
  user = dovecot
  unix_listener decode2text {
    mode = 0666
  }
}

# ------------------------------------------------------------------
# Квоты
# ------------------------------------------------------------------
# quota-status — policy-сервис для Postfix: тот спрашивает про получателя
# ещё на этапе RCPT TO и сразу отказывает, если ящик переполнен
# (в main.cf: check_policy_service inet:dovecot:12340).
service quota-status {
  executable = /usr/lib/dovecot/quota-status -p postfix
  inet_listener {
    port = 12340
  }
  client_limit = 1
}

# Письмо-предупреждение при приближении к лимиту.
# Запускаем от root — как и штатный dovecot-lda: он сам сбрасывает права до
# vmail по данным userdb. Из-под непривилегированного пользователя это
# невозможно (setgid), а ещё ему недоступен общий журнал контейнера.
service quota-warning {
  executable = script /usr/local/bin/quota-warning.sh
  user = root
  group = root
  unix_listener quota-warning {
    user = vmail
    group = vmail
    mode = 0660
  }
}

# Чтобы dovecot-lda из quota-warning мог писать статистику
service stats {
  unix_listener stats-writer {
    user = vmail
    group = vmail
    mode = 0660
  }
}

plugin {
  # ---------------- Раскладка при доставке (Sieve) ----------------
  # Личные правила пользователя.
  sieve = file:/var/mail/vhosts/%d/%n/sieve;active=/var/mail/vhosts/%d/%n/.dovecot.sieve

  # Раскладка спама — запасной скрипт, а НЕ sieve_before, и вот почему.
  #
  # sieve_before выполняется до личных правил, а наш спамный фильтр
  # заканчивается командой stop, которая прекращает всю цепочку скриптов.
  # Из-за этого письмо, помеченное как спам, до личных правил не доходило,
  # и возможность «применять фильтр к спаму» — она есть в интерфейсе и
  # была в mail.ru — не работала вовсе. Проверено на живом стеке.
  #
  # sieve_default применяется только к ящикам БЕЗ личного скрипта.
  # Ящики с личными правилами раскладывают спам сами: генератор правил
  # (apps/api/src/settings/sieve.ts) дописывает в конец личного скрипта
  # такой же блок, но уже ПОСЛЕ пользовательских правил — поэтому правило
  # с пометкой «применять к спаму» успевает сработать, а всё, что оно
  # не забрало, всё равно попадает в папку «Спам».
  sieve_default = /etc/dovecot/sieve/spam-to-junk.sieve
  sieve_default_name = spam-to-junk


  # ---------------- Полнотекстовый поиск (Xapian) ----------------
  fts = xapian
  # partial=3 — минимальная длина префикса для поиска по началу слова:
  #   индексируются n-граммы от 3 до 20 символов, поэтому находятся и словоформы
  #   («документ» найдёт «документы», «документов»), и поиск по части слова.
  # verbose=0 — без отладочного шума в лог.
  fts_xapian = partial=3 full=20 verbose=0

  # Индексировать при доставке письма (в фоне через indexer), а не при поиске
  fts_autoindex = yes
  # Спам и корзину в фоне не индексируем — как в mail.ru, поиск туда не лезет
  fts_autoindex_exclude = \Junk
  fts_autoindex_exclude2 = \Trash

  # Все поисковые запросы обслуживает индекс. Если индекса нет — Dovecot
  # сначала достроит его, а не свалится в медленный перебор.
  fts_enforced = yes

  # Разбор вложений: PDF, .doc/.xls/.ppt, OOXML, ODF, RTF
  fts_decoder = decode2text
  # Вложения крупнее 50 МБ не разбираем
  fts_message_max_size = 50M

  # ---------------- Квоты ----------------
  # Бэкенд maildir: занятое место считается по файлу maildirsize внутри Maildir,
  # без внешних словарей и лишней памяти. Лимит приходит из userdb (quota_rule),
  # то есть из столбца virtual_users.quota_bytes в Postgres.
  quota = maildir:User quota
  # Корзина в квоту входит (как в mail.ru), отдельного правила не задаём.

  # Внятный текст отказа вместо молчаливой потери письма
  quota_exceeded_message = Mailbox is over quota / Ящик получателя переполнен

  # Ответы policy-сервиса для Postfix
  quota_status_success = DUNNO
  quota_status_nouser = DUNNO
  quota_status_overquota = 552 5.2.2 Mailbox is over quota / Ящик получателя переполнен

  # Предупреждения владельцу ящика на 90% и 95% заполнения
  quota_warning = storage=90%% quota-warning 90 %u
  quota_warning2 = storage=95%% quota-warning 95 %u
}

protocol lmtp {
  postmaster_address = postmaster@${MAIL_DOMAIN}
  # sieve — раскладка при доставке: помеченный спам уходит в папку «Спам»,
  # дальше на этом же механизме будут работать пользовательские фильтры.
  mail_plugins = $mail_plugins sieve

  # Куда Sieve отправляет письма для действий «переслать» и «автоответчик».
  #
  # Без этой строки было очень плохо. Оба действия Pigeonhole выполняет через
  # программу отправки почты, а её в образе нет. Для «переслать» это ошибка
  # фатальная: скрипт прерывается целиком, LMTP отвечает временным отказом,
  # и письмо НЕ попадает в ящик вовсе — оно висит в очереди до истечения
  # срока (по умолчанию пять суток), а потом уходит отбойником отправителю.
  # То есть одно правило пересылки останавливало доставку всей почты в ящик.
  # Автоответчик при этом молча никогда не отвечал: там сбой нефатальный.
  #
  # Отправляем через собственный submission Postfix — тот же путь, которым
  # уходит почта из веб-интерфейса.
  #
  # Это настройка ДОСТАВКИ, а не плагина: внутри блока plugin она читается
  # как plugin/submission_host и не действует. Проверено на живом стенде —
  # первая попытка исправления была именно такой и ничего не изменила.
  # Порт 25, а не 587: submission требует шифрования и пароля, а тут
  # отправляет сам сервер. Право пересылать наружу даётся ровно
  # адресу Dovecot в mynetworks Postfix — см. main.cf.template.
  submission_host = postfix:25
  # Проверять квоту уже на RCPT TO: Postfix получит отказ до передачи тела
  # письма и вернёт его отправителю, а не примет и потом потеряет.
  lmtp_rcpt_check_quota = yes
}

protocol pop3 {
  # Стабильные UIDL, совместимые с большинством клиентов
  pop3_uidl_format = %08Xu%08Xv
  mail_max_userip_connections = 20
}

protocol imap {
  # imap_quota — расширение QUOTA: клиент видит занятое место (GETQUOTAROOT)
  mail_plugins = $mail_plugins imap_quota
  mail_max_userip_connections = 50
}

protocol doveadm {
  mail_plugins = $mail_plugins
}
