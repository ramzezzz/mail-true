# Глобальный фильтр, выполняется ДО пользовательских правил (sieve_before).
#
# Rspamd умеет только пометить письмо заголовком — разложить его по папкам
# может лишь принимающая сторона, то есть Dovecot. Без этого правила спам
# помечался бы, но продолжал падать во «Входящие», и фильтр был бы бесполезен.
#
# Порог, при котором ставится заголовок, задаётся в infra/rspamd/local.d/actions.conf
# (действие add_header). Письма выше порога отказа сюда вообще не доходят —
# их отклоняет Postfix на этапе приёма.

require ["fileinto", "mailbox"];

if header :is "X-Spam" "Yes" {
    # :create — на случай, если папка у ящика ещё не заведена
    fileinto :create "Spam";
    stop;
}
