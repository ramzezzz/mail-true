node_modules/
dist/
build/
.vite/
*.tsbuildinfo

.env
.env.*
!.env.example

# данные почтового стека (Maildir, БД, ключи DKIM)
infra/data/
infra/secrets/
*.pem
*.key

# артефакты исследования интерфейса
.playwright-mcp/
research/**/*.png
research/**/*.har
# Выгрузки сняты с живого ящика и могут содержать переписку и адреса.
# Они полезны как справочник по вёрстке, но в общий доступ им нельзя.
# Обезличенные копии при необходимости добавляйте принудительно.
research/mailru/*.json
# ...кроме одного файла: design-tokens-raw.json — это НЕ выгрузка почты,
# а таблица цветов, отступов и шрифтов, и его КОПИРУЮТ СБОРКИ образов
# (apps/web/Dockerfile, apps/admin/Dockerfile). Пока он был скрыт от
# репозитория, установка из свежей копии кода была невозможна в принципе:
# `docker compose build` падал на
#   COPY research/mailru/design-tokens-raw.json: not found
# ещё до того, как что-либо поднималось. Проверено сборкой из каталога,
# куда попало только то, что видит git.
!research/mailru/design-tokens-raw.json

logs/
*.log
npm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Рабочие следы проверок: снимки экрана, снятые агентами при проверке правок.
# Полезны в момент проверки, но к продукту отношения не имеют.
.shots/
*-raw.png
docs/manual/build/

# Отладочные снимки и ответы, которые оставляют проверки в КОРНЕ репозитория.
# Их регулярно забывают убрать, а к продукту они отношения не имеют.
# Именованные шаблоны, а не «*.png»: у продукта есть свои картинки
# (apps/web/public/brand, обои, снимки для руководства) — их терять нельзя.
/*.png
/*.jar
/resp-*.json
/.playwright-mcp/

# Проба установщика: проверяет, видит ли docker каталог проекта.
# Живёт доли секунды и удаляется сама, но если установку прервать
# посередине (Ctrl+C), файл останется — в репозиторий ему не надо.
/.mt-docker-probe.yml
