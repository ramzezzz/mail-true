# Файл ответов для неинтерактивной установки Mail.True.
#
#   cp install/answers.example.env /root/mailtrue.env
#   nano /root/mailtrue.env
#   chmod 600 /root/mailtrue.env
#   sudo bash install/install.sh --answers /root/mailtrue.env
#
# Файл просто подключается (source) установщиком, поэтому это обычный
# синтаксис shell: КЛЮЧ=значение, значения с пробелами — в кавычках.
# В нём лежит пароль администратора, так что права 600 и не в репозиторий.

# ------------------------------------------------------------------
# Обязательные
# ------------------------------------------------------------------

# Почтовый домен — то, что стоит после @ в адресах.
MAILTRUE_DOMAIN=example.ru

# Имя сервера (FQDN). Попадает в HELO, в сертификат и в PTR-запись.
# Должно иметь A-запись, указывающую на этот сервер.
MAILTRUE_HOSTNAME=mail.example.ru

# Адрес администратора: под ним создаётся ящик, на него ведут
# postmaster@ и abuse@.
MAILTRUE_ADMIN_EMAIL=admin@example.ru

# Пароль администратора — и для ящика, и для входа в админку.
# Минимум 10 символов. Если оставить пустым, установщик придумает
# случайный и покажет его в конце (тогда не потеряйте вывод).
#
# ВНИМАНИЕ: значение ниже — заглушка. Она длиннее десяти символов и потому
# проходила проверку длины: боевые серверы уезжали в работу с паролем,
# который есть в этом файле в репозитории. Теперь установщик такие пароли
# отвергает, а install/selfcheck.sh проверяет, не остался ли такой пароль
# в базе. Впишите сюда свой — или оставьте строку пустой.
MAILTRUE_ADMIN_PASSWORD='смените-этот-пароль'

# ------------------------------------------------------------------
# Необязательные (показаны значения по умолчанию)
# ------------------------------------------------------------------

# Отдельный пароль для почтового ящика, если не хочется одинаковых.
#MAILTRUE_MAILBOX_PASSWORD='другой-пароль'

# Логин в админке. По умолчанию — часть адреса до @.
#MAILTRUE_ADMIN_LOGIN=admin

# Антивирус ClamAV: yes добавляет около 1 ГБ к потреблению памяти.
# Имеет смысл при 4 ГБ и больше; включить можно и позже.
# Допустимо только yes или no — опечатку установщик отвергает, а не
# трактует молча как значение по умолчанию.
MAILTRUE_CLAMAV=no

# Сертификат: letsencrypt (нужен публичный домен, указывающий сюда)
# или selfsigned (для стенда без домена).
# Другие значения установщик отвергает.
MAILTRUE_TLS=letsencrypt

# Адрес для уведомлений Let's Encrypt об истечении срока.
# По умолчанию — MAILTRUE_ADMIN_EMAIL.
#MAILTRUE_LE_EMAIL=admin@example.ru

# Адрес, на котором публиковать порты. 0.0.0.0 — все интерфейсы.
# Меняйте, только если точно знаете зачем.
#MAILTRUE_BIND_ADDRESS=0.0.0.0

# Не проверять занятость портов и исходящий 25-й (для стендов).
#MAILTRUE_SKIP_PORT_CHECK=1
