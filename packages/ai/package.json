{
  "name": "@mail-true/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Помощник на основе ИИ для Mail.True: резюме, категории, ответы, извлечение данных, перевод и поиск обычными словами",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "npm run build && node --test \"dist/__tests__/*.test.js\"",
    "livetest": "npm run build && node dist/livetest.js"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  }
}
